---
const examples = [
  {
    id: 'log', tab: 'Event log', title: 'Record what happened.',
    technology: 'OrderedLog', intro: 'Keep a shared, verifiable history of application events.',
    commandLabel: 'SIGNED APPLICATION EVENT', command: 'order.created', value: '#A-100',
    facts: [['Record', 'Order A-100 was created'], ['Claim', 'This event appears in the agreed history']],
    root: '9f3c…a17b', result: 'One event. One agreed history.', href: '/tutorials/01-first-app-chain/',
    stages: [
      ['Submit', 'A signed command is submitted to the application. Acceptance does not yet mean members have agreed on the result.'],
      ['Execute', 'Every member records the same ordered events and computes the same state root.'],
      ['Certify', 'The configured member threshold certifies the result. A proof can establish that this event was recorded.'],
      ['Anchor', 'Optionally publish a certified commitment to Cardano. Cardano confirmation is separate from member agreement.'],
    ],
  },
  {
    id: 'map', tab: 'Registry', title: 'Verify the current record.',
    technology: 'Authenticated map', intro: 'Manage named collections with controlled updates and proofs of their state.',
    commandLabel: 'AUTHORIZED REGISTRY UPDATE', command: 'assets / A-100', value: 'revision 2',
    facts: [['Check', 'Writer is authorized; revision matches'], ['Record', 'Asset A-100 · status ACTIVE']],
    root: '7ba2…c940', result: 'A record you can independently verify.', href: '/state-machines/authenticated-map/',
    stages: [
      ['Submit', 'An authorized writer requests an update to asset A-100 at its expected revision.'],
      ['Execute', 'Every member checks the collection policy and revision before applying the same update.'],
      ['Certify', 'A proof binds this entry and its revision to the certified state. Absence and revocation are distinct states.'],
      ['Anchor', 'Optionally publish the certified commitment to Cardano. The proof establishes the recorded state, not the truth of an asset description.'],
    ],
  },
  {
    id: 'roles', tab: 'Roles', title: 'The right people approve.',
    technology: 'Domain roles + approval workflows', intro: 'Business roles belong to people and organizations, independently of node operators.',
    commandLabel: 'ACTOR-SIGNED APPROVALS', command: 'document / D-204', value: 'release request',
    facts: [['Issuer', 'Proposes this exact document digest'], ['Auditors', 'Two distinct organizations approve']],
    root: 'a812…6f04', result: 'Approval bound to the exact action.', href: '/tutorials/05-domain-role-approvals/',
    stages: [
      ['Propose', 'An issuer proposes a document release. The policy identifies the roles and organizations whose approval is required.'],
      ['Check', 'Every member checks actor signatures, current roles, and the distinct-organization requirement.'],
      ['Certify', 'The approved action is recorded under the shared rules. Business approval and the member finality threshold are separate checks.'],
      ['Anchor', 'Optionally anchor the commitment to the approved record. This proves the recorded approvals, not the truth of the document.'],
    ],
  },
  {
    id: 'observe', tab: 'Observations', title: 'Use outside evidence.',
    technology: 'Generic observations · preview example', intro: 'Bring a signed delivery report into a workflow without making network calls inside application rules.',
    commandLabel: 'SOURCE-ATTESTED DELIVERY REPORT', command: 'shipment / A-100', value: 'DELIVERED',
    facts: [['Source', 'Authorized attestor signs a commitment'], ['Evidence', 'Delivery claim is bound to this shipment']],
    root: 'c320…d5e1', result: 'Certified input for the next decision.', href: '/concepts/observations/',
    stages: [
      ['Request', 'The application requests a delivery observation tied to the payment for this shipment. Acquisition happens outside deterministic execution.'],
      ['Check', 'The host checks the source signature, inclusion evidence, and the pinned observation policy. Members agree on the accepted result.'],
      ['Certify', 'The application consumes the finalized observation result. The signed report establishes what the attestor committed, not that a parcel physically arrived.'],
      ['Anchor', 'Optionally anchor the resulting application commitment. Observations bring information in; effects authorize actions outside the application.'],
    ],
  },
];
const first = examples[0];
---
<div class="chain-demo" data-stage="2">
  <div class="demo-heading"><span>EXPLORE A SHARED APPLICATION</span><span class="demo-label">ILLUSTRATION</span></div>
  <div class="example-tabs" role="tablist" aria-label="Application illustrations" hidden>
    {examples.map((example, i) => <button role="tab" id={`example-${example.id}`} data-example={i}
      aria-selected={i === 0} aria-controls="example-panel" tabindex={i === 0 ? 0 : -1}>{example.tab}</button>)}
  </div>
  <div id="example-panel" role="tabpanel" aria-labelledby="example-log" tabindex="0">
    <div class="example-intro"><h2>{first.title}</h2><p>{first.intro}</p></div>
    <div class="command"><span>{first.commandLabel}</span><code><span data-command>{first.command}</span> <b>{first.value}</b></code></div>
    <dl class="example-facts">{first.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    <div class="flow-wire" aria-hidden="true"></div>
    <div class="members">{['Member A', 'Member B', 'Member C'].map(name => <div class="member"><span>{name}</span><div class="node-mark" aria-hidden="true">◇</div><code>{first.root}</code><small>same state root</small></div>)}</div>
    <div class="flow-wire" aria-hidden="true"></div>
    <div class="certificate"><span>MEMBER-CERTIFIED RESULT</span><strong>{first.result}</strong></div>
    <div class="demo-controls" role="group" aria-label="Walk through an application command" hidden>
      {first.stages.map(([title], i) => <button data-stage-button={i} aria-pressed={i === 2} aria-controls="stage-description"><span>0{i + 1}</span><span data-stage-label>{title}</span></button>)}
    </div>
    <p id="stage-description" aria-live="polite" aria-atomic="true">{first.stages[2][1]}</p>
    <div class="example-footer"><button class="replay" hidden>Replay the flow ↻</button><a data-guide href={first.href}>{first.technology} ↗</a></div>
    <p class="example-disclaimer">Example data · optional Cardano anchoring</p>
  </div>
  <noscript><p class="example-disclaimer">Explore more examples: <a href="/state-machines/authenticated-map/">registries</a>, <a href="/tutorials/05-domain-role-approvals/">roles</a>, and <a href="/concepts/observations/">observations</a>.</p></noscript>
  <script define:vars={{ examples }}>
    const demo = document.querySelector('.chain-demo');
    const panel = demo.querySelector('#example-panel');
    const tabs = [...demo.querySelectorAll('[data-example]')];
    const controls = demo.querySelector('.demo-controls');
    const replay = demo.querySelector('.replay');
    demo.querySelector('.example-tabs').hidden = controls.hidden = replay.hidden = false;
    let selected = 0;
    let timer;
    let playing = false;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    function stop() {
      clearTimeout(timer); playing = false;
      replay.textContent = reduced.matches ? 'Next step →' : 'Replay the flow ↻';
    }
    function show(index) {
      demo.dataset.stage = String(index);
      controls.querySelectorAll('button').forEach(button => button.setAttribute('aria-pressed', String(Number(button.dataset.stageButton) === index)));
      demo.querySelector('#stage-description').textContent = examples[selected].stages[index][1];
    }
    function selectExample(index) {
      stop(); selected = index;
      const example = examples[index];
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panel.setAttribute('aria-labelledby', tabs[index].id);
      demo.querySelector('.example-intro h2').textContent = example.title;
      demo.querySelector('.example-intro p').textContent = example.intro;
      demo.querySelector('.command > span').textContent = example.commandLabel;
      demo.querySelector('[data-command]').textContent = example.command;
      demo.querySelector('.command b').textContent = example.value;
      demo.querySelectorAll('.example-facts div').forEach((row, i) => {
        row.querySelector('dt').textContent = example.facts[i][0];
        row.querySelector('dd').textContent = example.facts[i][1];
      });
      demo.querySelectorAll('.member code').forEach(node => node.textContent = example.root);
      demo.querySelector('.certificate strong').textContent = example.result;
      demo.querySelectorAll('[data-stage-label]').forEach((label, i) => label.textContent = example.stages[i][0]);
      const guide = demo.querySelector('[data-guide]');
      guide.textContent = example.technology + ' ↗'; guide.href = example.href;
      show(2);
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectExample(index));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length
          : event.key === 'ArrowLeft' ? (index + tabs.length - 1) % tabs.length
          : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
        if (next === null) return;
        event.preventDefault(); selectExample(next); tabs[next].focus();
      });
    });
    controls.querySelectorAll('button').forEach(button => button.addEventListener('click', () => { stop(); show(Number(button.dataset.stageButton)); }));
    replay.addEventListener('click', () => {
      if (playing) { stop(); return; }
      if (reduced.matches) { show((Number(demo.dataset.stage) + 1) % 4); return; }
      playing = true; replay.textContent = 'Pause the flow';
      let index = 0; show(index);
      const next = () => { if (++index < 4) { show(index); timer = setTimeout(next, 2200); } else stop(); };
      timer = setTimeout(next, 2200);
    });
    stop();
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    reduced.addEventListener('change', stop);
  </script>
</div>
