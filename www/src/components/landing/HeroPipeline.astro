---
/**
 * The app-chain pipeline, as the landing page's hero illustration.
 *
 * It shows the one claim that distinguishes an app chain from a shared
 * database: three organizations independently execute the same command and
 * derive the *same* state root, a threshold signs it, and that root settles on
 * Cardano while effects fan out to external systems.
 *
 * The three identical root chips are the point of the drawing, so they pulse in
 * unison rather than in sequence.
 */
---

<div class="hero-pipeline">
  <svg
    viewBox="0 0 620 300"
    role="img"
    aria-labelledby="pipeline-title pipeline-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="pipeline-title">How a Yano app chain finalizes a command</title>
    <desc id="pipeline-desc">
      A signed command is relayed to three member nodes. Each independently
      re-executes it and derives the identical state root 9f3c…a17b. A
      threshold-signed app block commits that root, which is then anchored on
      Cardano and released to external effect executors.
    </desc>

    <defs>
      <linearGradient id="hp-flow" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#67e8f9" />
        <stop offset="45%" stop-color="#7c5cff" />
        <stop offset="100%" stop-color="#ff4d9d" />
      </linearGradient>
      <linearGradient id="hp-card" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#191338" />
        <stop offset="100%" stop-color="#120e2a" />
      </linearGradient>
      <linearGradient id="hp-block" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#221a4d" />
        <stop offset="100%" stop-color="#150f33" />
      </linearGradient>
      <radialGradient id="hp-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#7c5cff" stop-opacity="0.30" />
        <stop offset="100%" stop-color="#7c5cff" stop-opacity="0" />
      </radialGradient>
      <filter id="hp-soft" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="5" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <ellipse cx="504" cy="120" rx="150" ry="110" fill="url(#hp-glow)" />

    <!-- ── connectors ────────────────────────────────────────────────── -->
    <g class="hp-wires" fill="none" stroke="url(#hp-flow)" stroke-width="1.6">
      <!-- relay: command → each member -->
      <path class="hp-wire" d="M132 120 C 156 120, 156 52, 178 52" />
      <path class="hp-wire" d="M132 120 L 178 120" />
      <path class="hp-wire" d="M132 120 C 156 120, 156 188, 178 188" />
      <!-- agreement: each member → the block -->
      <path class="hp-wire" d="M362 52  C 384 52, 384 120, 404 120" />
      <path class="hp-wire" d="M362 120 L 404 120" />
      <path class="hp-wire" d="M362 188 C 384 188, 384 120, 404 120" />
      <!-- release: block → anchor and effects -->
      <path class="hp-wire" d="M504 163 C 504 182, 452 178, 452 197" />
      <path class="hp-wire" d="M504 163 C 504 182, 556 178, 556 197" />
    </g>

    <!-- ── 1 · signed command ────────────────────────────────────────── -->
    <text class="hp-step" x="8" y="72">1 · SIGNED COMMAND</text>
    <g transform="translate(8 84)">
      <rect width="124" height="72" rx="11" fill="url(#hp-card)" stroke="#2e2560" />
      <circle cx="18" cy="20" r="4.5" fill="#67e8f9" />
      <text class="hp-label" x="31" y="24">orders-chain</text>
      <text class="hp-mono hp-dim" x="14" y="45">order-created</text>
      <g transform="translate(14 53)">
        <rect width="58" height="14" rx="7" fill="#67e8f9" fill-opacity="0.12" stroke="#67e8f9" stroke-opacity="0.4" />
        <text class="hp-pill" x="29" y="10" text-anchor="middle" fill="#8ceffd">ed25519</text>
      </g>
    </g>

    <!-- ── 2 · deterministic execution ───────────────────────────────── -->
    <text class="hp-step" x="178" y="12">2 · EVERY MEMBER RE-EXECUTES</text>
    <g transform="translate(178 24)">
      <g class="hp-member">
        <rect width="184" height="56" rx="11" fill="url(#hp-card)" stroke="#2e2560" />
        <circle cx="17" cy="19" r="4.5" fill="#7c5cff" />
        <text class="hp-label" x="30" y="23">node-0 · proposer</text>
        <g class="hp-root" transform="translate(14 31)">
          <rect width="156" height="16" rx="8" fill="#7c5cff" fill-opacity="0.12" stroke="#7c5cff" stroke-opacity="0.42" />
          <text class="hp-mono" x="9" y="11.5" fill="#c3b5ff">root 9f3c…a17b</text>
        </g>
      </g>
      <g class="hp-member" transform="translate(0 68)">
        <rect width="184" height="56" rx="11" fill="url(#hp-card)" stroke="#2e2560" />
        <circle cx="17" cy="19" r="4.5" fill="#7c5cff" />
        <text class="hp-label" x="30" y="23">node-1</text>
        <g class="hp-root" transform="translate(14 31)">
          <rect width="156" height="16" rx="8" fill="#7c5cff" fill-opacity="0.12" stroke="#7c5cff" stroke-opacity="0.42" />
          <text class="hp-mono" x="9" y="11.5" fill="#c3b5ff">root 9f3c…a17b</text>
        </g>
      </g>
      <g class="hp-member" transform="translate(0 136)">
        <rect width="184" height="56" rx="11" fill="url(#hp-card)" stroke="#2e2560" />
        <circle cx="17" cy="19" r="4.5" fill="#7c5cff" />
        <text class="hp-label" x="30" y="23">node-2</text>
        <g class="hp-root" transform="translate(14 31)">
          <rect width="156" height="16" rx="8" fill="#7c5cff" fill-opacity="0.12" stroke="#7c5cff" stroke-opacity="0.42" />
          <text class="hp-mono" x="9" y="11.5" fill="#c3b5ff">root 9f3c…a17b</text>
        </g>
      </g>
    </g>
    <text class="hp-note" x="270" y="232" text-anchor="middle">identical, byte for byte</text>

    <!-- ── 3 · threshold finality ────────────────────────────────────── -->
    <text class="hp-step" x="404" y="65">3 · THRESHOLD-FINAL</text>
    <g transform="translate(404 77)">
      <rect width="200" height="86" rx="13" fill="url(#hp-block)" stroke="#4a3a9e" filter="url(#hp-soft)" />
      <text class="hp-label" x="16" y="26" fill="#efeafd">app block #1042</text>
      <g transform="translate(16 36)">
        <rect width="168" height="17" rx="8.5" fill="#0d0a20" stroke="#3b2f7d" />
        <text class="hp-mono" x="9" y="12" fill="#c3b5ff">root 9f3c…a17b</text>
      </g>
      <g class="hp-sigs" transform="translate(16 62)">
        <g class="hp-sig">
          <circle cx="7" cy="7" r="7" fill="#22c55e" fill-opacity="0.16" stroke="#22c55e" stroke-opacity="0.55" />
          <path d="M4 7.2 L6.2 9.4 L10.2 4.8" fill="none" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <g class="hp-sig" transform="translate(19 0)">
          <circle cx="7" cy="7" r="7" fill="#22c55e" fill-opacity="0.16" stroke="#22c55e" stroke-opacity="0.55" />
          <path d="M4 7.2 L6.2 9.4 L10.2 4.8" fill="none" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <g class="hp-sig" transform="translate(38 0)">
          <circle cx="7" cy="7" r="7" fill="#22c55e" fill-opacity="0.16" stroke="#22c55e" stroke-opacity="0.55" />
          <path d="M4 7.2 L6.2 9.4 L10.2 4.8" fill="none" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text class="hp-pill" x="58" y="10" fill="#7fdca0">3 of 3 signed</text>
      </g>
    </g>

    <!-- ── settlement and effects ────────────────────────────────────── -->
    <g transform="translate(404 197)">
      <rect class="hp-anchor" width="96" height="62" rx="11" fill="url(#hp-card)" stroke="#2e2560" />
      <text class="hp-label" x="14" y="24">Cardano</text>
      <text class="hp-label" x="14" y="37">anchor</text>
      <text class="hp-mono hp-dim" x="14" y="52">4d80…c2e9</text>
    </g>
    <g transform="translate(508 197)">
      <rect width="96" height="62" rx="11" fill="url(#hp-card)" stroke="#2e2560" />
      <text class="hp-label" x="14" y="24">Effects</text>
      <text class="hp-mono hp-dim" x="14" y="39">Kafka · S3</text>
      <text class="hp-mono hp-dim" x="14" y="51">IPFS · HTTP</text>
    </g>
  </svg>
</div>

<style>
  .hero-pipeline {
    width: 100%;
  }

  .hero-pipeline svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Type inside the illustration */
  .hp-step {
    font-family: var(--l-mono);
    font-size: 8.5px;
    letter-spacing: 0.11em;
    fill: #7a6fae;
  }

  .hp-label {
    font-family: var(--l-sans);
    font-size: 11px;
    font-weight: 600;
    fill: #ddd8f2;
  }

  .hp-mono {
    font-family: var(--l-mono);
    font-size: 9.5px;
    fill: #b3aad6;
  }

  .hp-pill {
    font-family: var(--l-mono);
    font-size: 8.5px;
  }

  .hp-note {
    font-family: var(--l-sans);
    font-size: 9.5px;
    font-style: italic;
    fill: #7a6fae;
  }

  .hp-dim {
    opacity: 0.72;
  }

  /* Flow along the wires */
  .hp-wire {
    stroke-dasharray: 5 7;
    animation: hp-flow 1.4s linear infinite;
  }

  @keyframes hp-flow {
    to {
      stroke-dashoffset: -12;
    }
  }

  /* The three roots agree, so they breathe together — never staggered. */
  .hp-root {
    animation: hp-agree 3.2s ease-in-out infinite;
  }

  @keyframes hp-agree {
    0%, 62%, 100% { opacity: 0.78; }
    76% { opacity: 1; }
  }

  .hp-sig {
    animation: hp-sign 3.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hp-sigs .hp-sig:nth-child(2) { animation-delay: 0.12s; }
  .hp-sigs .hp-sig:nth-child(3) { animation-delay: 0.24s; }

  @keyframes hp-sign {
    0%, 70%, 100% { opacity: 0.55; }
    82% { opacity: 1; }
  }

  .hp-anchor {
    animation: hp-settle 3.2s ease-in-out infinite;
  }

  @keyframes hp-settle {
    0%, 84%, 100% { stroke: #2e2560; }
    92% { stroke: #7c5cff; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-wire,
    .hp-root,
    .hp-sig,
    .hp-anchor {
      animation: none;
    }
    .hp-wire { stroke-dasharray: none; }
  }
</style>
