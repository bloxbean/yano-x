---
/**
 * Starlight <Head> override.
 *
 * Adds the controls for the illustrations rendered by
 * scripts/remark-illustrations.mjs. The bundle is loaded with a dynamic import,
 * so pages without an illustration never fetch it.
 */
const { head } = Astro.locals.starlightRoute;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script>
  async function enhanceIllustrations() {
    if (!document.querySelector('[data-yx-illustration]')) return;
    const { enhanceIllustrations: enhance } = await import('../../illustrations/client.js');
    enhance();
  }

  void enhanceIllustrations();
  document.addEventListener('astro:after-swap', enhanceIllustrations);
</script>
