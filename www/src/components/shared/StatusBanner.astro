---
/**
 * The site-wide project status banner. This file is the only place the message
 * lives: documentation pages render it through the Starlight `Banner` override
 * (src/components/overrides/Banner.astro) and the landing page renders it
 * directly. Edit or remove the message here.
 */
interface Props {
  /** `landing` spans the full width above the landing header. */
  variant?: 'docs' | 'landing';
}

const { variant = 'docs' } = Astro.props;
---

<aside class:list={['status-banner', `status-banner--${variant}`]} aria-label="Project status" data-pagefind-ignore>
  <p>
    <strong class="status-banner__label">Active development</strong>
    <span>
      Yano X is working toward its first developer preview. Until then, explore the docs to learn the
      ideas behind Yano X and what it makes possible.
    </span>
    <a class="status-banner__link" href="https://github.com/bloxbean/yano-x">Follow on GitHub ↗</a>
  </p>
</aside>

<style>
  .status-banner {
    --status-accent: #9af0d4;
    --status-ink: #dbe6ea;
    --status-bg: #12302a;
    --status-line: #2f6b5b;
    border: 1px solid var(--status-line);
    border-radius: 10px;
    background: var(--status-bg);
    color: var(--status-ink);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  :global(:root[data-theme='light']) .status-banner--docs {
    --status-accent: #12694f;
    --status-ink: #17242c;
    --status-bg: #e3f6ee;
    --status-line: #a9dcc8;
  }

  .status-banner p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0.6rem 0.9rem;
  }

  .status-banner__label {
    color: var(--status-accent);
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status-banner p > span {
    flex: 1 1 22rem;
    min-width: 0;
  }

  .status-banner__link {
    color: var(--status-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .status-banner__link:hover {
    text-decoration: underline;
  }

  .status-banner__link:focus-visible {
    outline: 2px solid var(--status-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .status-banner--docs {
    margin-bottom: 1.5rem;
  }

  .status-banner--landing {
    --status-accent: #12694f;
    --status-ink: #14211b;
    --status-bg: #e3f6ee;
    --status-line: #a9dcc8;
    border-width: 0 0 1px;
    border-radius: 0;
  }

  .status-banner--landing p {
    width: min(1280px, calc(100% - 96px));
    margin-inline: auto;
    padding-inline: 0;
  }

  @media (max-width: 720px) {
    .status-banner--landing p {
      width: calc(100% - 32px);
    }
  }
</style>
