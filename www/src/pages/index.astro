---
import '../styles/landing.css';
import Brand from '../components/shared/Brand.astro';
import HeroPipeline from '../components/landing/HeroPipeline.astro';
import { generateCatalog } from '../../scripts/generate-catalog.mjs';
const { counts, versions } = await generateCatalog({ logger: { info: () => {} } });
const paths = [
  { id: 'record', label: 'Shared records', title: 'One record. Every member agrees.', text: 'Track ownership, documents, or attestations across organizations. Start with a registry or document trail, then retrieve a proof of the recorded state.', machine: 'Registry · Document trail', steps: ['Submit a signed update', 'Apply the same rules on every member', 'Verify a record against the certified root'], href: '/tutorials/02-registry-and-proofs/', cta: 'Build a registry' },
  { id: 'coordinate', label: 'Approval workflows', title: 'Make the rules part of the record.', text: 'Give people business roles — issuer, reviewer, auditor — separate from the members running the software. Require approval from the right roles and organizations before an action proceeds.', machine: 'Role approvals · Composition', steps: ['Define participants and roles', 'Collect the required approvals', 'Record the authorized transition'], href: '/tutorials/05-domain-role-approvals/', cta: 'Explore role approvals' },
  { id: 'observe', label: 'External observations', title: 'Bring outside evidence into shared decisions.', text: 'Receive a signed delivery report or another supported external input. Members check the evidence against agreed source and acceptance rules before your application uses the certified result. A source report is evidence of its claim, not proof of physical delivery.', machine: 'Generic observations · Signed source evidence', steps: ['Request an external observation', 'Check source evidence and acceptance rules', 'Apply the certified result'], href: '/concepts/observations/', cta: 'Understand observations' },
  { id: 'connect', label: 'External actions', title: 'Connect decisions to the real world.', text: 'Authorize a webhook, publication, or payment from a finalized transition. Executors handle network work outside consensus; results return as sequenced messages.', machine: 'Effects · Connectors', steps: ['Commit an effect request', 'Execute outside consensus', 'Incorporate the reported result'], href: '/tutorials/06-webhook-effects/', cta: 'Connect a webhook' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yano X — Your application. Shared rules. Verifiable results.</title>
    <meta name="description" content="Yano X is a shared application platform for Java. Build shared records, approval workflows, and integrations with independently verifiable results and optional Cardano commitments." />
    <meta name="theme-color" content="#0b1115" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://yano-x.io/" />
    <meta property="og:title" content="Yano X — Your application. Shared rules. Verifiable results." />
    <meta property="og:description" content="A shared application platform for Java. Start with shared records and workflows. Grow into your own rules." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yano-x.io/" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI documentation index" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <Brand />
      <nav aria-label="Main navigation"><a href="/start-here/">Docs</a><a href="#explore">Explore</a><a href="/ai/">For AI</a><a href="https://github.com/bloxbean/yano-x">GitHub ↗</a></nav>
    </header>
    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <a class="eyebrow release" href="/start-here/release-downloads/">OPEN SOURCE <span>↗</span></a>
          <h1>Your application.<br />Shared rules.<br /><em>Verifiable results.</em></h1>
          <p class="lede">Yano X is a shared application platform for Java. Build applications that organizations run together, with shared records, approval workflows, and integrations — and results participants can independently verify.</p>
          <div class="actions"><a class="button primary" href="/start-here/quickstart/">Try the local demo <span>↗</span></a><a class="button secondary" href="#explore">Explore what you can build →</a></div>
          <p class="hero-meta">JAVA {versions.javaVersion} <span>/</span> JVM PLUGINS <span>/</span> CARDANO ANCHORING</p>
        </div>
        <HeroPipeline />
      </section>
      <section class="foundation wrap" aria-label="Yano and Yano X">
        <p><span class="eyebrow">ONE FOUNDATION. YOUR EXTENSIONS.</span><strong><a href="https://getyano.dev/">Yano</a> provides the foundation.<br /><span>Yano X makes it yours.</span></strong></p>
        <p>Powered by Yano, with optional commitments published to Cardano. Yano coordinates member agreement and provides verifiable records. Yano X adds your application rules and integrations as JVM plugins. Connect over HTTP from any language.</p>
        <a class="text-link" href="/start-here/why-yano-x/">Understand the relationship ↗</a>
      </section>
      <section class="section wrap" id="why">
        <div class="section-heading"><span class="eyebrow">WHY SHARED APPLICATIONS?</span><h2>Less reconciliation.<br /><span>More shared certainty.</span></h2><p>When several organizations need to agree on what happened, a shared API alone is not the whole answer.</p></div>
        <div class="values">
          <article><span class="index">01 / AGREE</span><h3>The same rules.<br />On every member.</h3><p>Members independently execute ordered commands and certify the resulting state. Agreement follows the configured member threshold.</p><a href="/concepts/consensus-and-finality/">Understand finality ↗</a></article>
          <article><span class="index">02 / VERIFY</span><h3>Evidence you<br />can check.</h3><p>Verify supported state claims against a certified root. Optionally anchor commitments on Cardano for an independently observable L1 record.</p><a href="/concepts/state-and-proofs/">Explore proofs ↗</a></article>
          <article><span class="index">03 / EXTEND</span><h3>Your domain.<br />Without a host fork.</h3><p>Choose existing capabilities, compose workflows, or build Java plugins. Keep application rules separate from the infrastructure that coordinates members.</p><a href="/plugins/">Meet the plugin framework ↗</a></article>
        </div>
      </section>
      <section class="explore section" id="explore"><div class="wrap">
        <div class="section-heading"><span class="eyebrow">WHAT WILL YOU BUILD?</span><h2>Start with the outcome.</h2><p>Explore a path. You can learn the underlying machinery as you go.</p></div>
        <div class="path-buttons" role="group" aria-label="Explore application examples" hidden>{paths.map((p, i) => <button data-path={p.id} aria-pressed={i === 0} aria-controls={`path-${p.id}`}>{p.label}</button>)}</div>
        {paths.map((p, i) => <article class="path-panel" id={`path-${p.id}`} data-panel={p.id}>
          <div><span class="eyebrow">0{i + 1} / {p.machine}</span><h3>{p.title}</h3><p>{p.text}</p><a class="button secondary" href={p.href}>{p.cta} ↗</a></div>
          <ol class="flow-list">{p.steps.map((step, j) => <li><span>0{j + 1}</span>{step}</li>)}</ol>
        </article>)}
      </div></section>
      <section class="section wrap" id="start">
        <div class="section-heading"><span class="eyebrow">A SMALL FIRST STEP</span><h2>See it work.<br /><span>Then make it yours.</span></h2><p>Start on a private local devnet. No public-network wallet or test ADA needed.</p></div>
        <div class="start-grid"><ol class="learning-path">
          <li><span>01</span><div><h3>Run the local demo</h3><p>Download the showcase archive, check prerequisites, and start three members.</p><a href="/start-here/quickstart/">Follow the local quickstart →</a></div></li>
          <li><span>02</span><div><h3>Submit. Inspect. Verify.</h3><p>Send an event, compare member state, and understand what a proof establishes.</p><a href="/tutorials/">Continue with guided tutorials →</a></div></li>
          <li><span>03</span><div><h3>Choose your own rules</h3><p>Pick a recipe, configure your application, then extend only where you need to.</p><a href="/recipes/choosing-a-recipe/">Choose a recipe →</a></div></li>
        </ol><div class="terminal"><div class="terminal-bar"><span>LOCAL DEMO</span><span>bash</span></div><p>After extracting <code>yano-showcase-&lt;version&gt;.zip</code></p><pre><code># Check Java 25 and local prerequisites
./showcase.sh doctor --profile light

# Start a private three-member devnet
./showcase.sh quickstart \
  --profile light --nodes 3 --instance first-demo

# Check agreement, then open the console
./showcase.sh verify all --instance first-demo
./showcase.sh ui --instance first-demo

# Keep your data for next time
./showcase.sh stop --instance first-demo</code></pre><a href="/start-here/release-downloads/">Choose the right download ↗</a></div></div>
      </section>
      <section class="section resources wrap"><div><span class="eyebrow">WHEN YOU ARE READY</span><h2>Room to go deeper.</h2><p>Keep learning at your pace. The reference is here when you need it.</p></div><div class="resource-links"><a href="/plugins/"><span>Build a plugin<small>Custom rules, composition, and integrations</small></span>↗</a><a href="/deployment/"><span>Plan a deployment<small>Configuration, operations, and member lifecycle</small></span>↗</a><a href="/studio/"><span>Design in Studio<small>Explore and export an application blueprint</small></span>↗</a><a href="/ai/"><span>Work with a coding agent<small>Guides, machine-readable catalogs, and llms.txt</small></span>↗</a></div></section>
      <div class="catalog-strip wrap"><span>{counts.recipes} recipes</span><span>{counts.capabilities} capabilities</span><a href="/reference/modules/">Explore the generated catalog →</a></div>
      <p class="release-note wrap">Yano X is pre-release. Begin with local development and validate security, operations, and domain behavior before production use. Documentation follows this checkout; use the identities and manifests shipped with your downloaded release.</p>
    </main>
    <footer class="wrap"><Brand caption={false} /><p>Yano X {versions.yanoXVersion} · Yano {versions.yanoVersion} · MIT</p><a href="https://getyano.dev/">Explore Yano ↗</a><a href="/reference/modules/">{versions.group}</a></footer>
    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-path]');
      const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
      document.querySelector<HTMLElement>('.path-buttons')!.hidden = false;
      function selectPath(id: string) {
        buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.path === id)));
        panels.forEach(panel => panel.hidden = panel.dataset.panel !== id);
      }
      buttons.forEach(button => button.addEventListener('click', () => selectPath(button.dataset.path!)));
      selectPath('record');
    </script>
  </body>
</html>
