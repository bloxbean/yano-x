ARG RUNNER_BASE_IMAGE
FROM ${RUNNER_BASE_IMAGE}

ARG RUNNER_UID=10001
ARG RUNNER_GID=10001

# Numeric ownership avoids a package-manager/user-database mutation. The
# Compose launcher overrides it with the same non-root host identity used for
# bind-mounted reports; neither path needs a passwd entry in this image.
COPY --chown=${RUNNER_UID}:${RUNNER_GID} runner.jar /opt/yano-demo/runner.jar

USER ${RUNNER_UID}:${RUNNER_GID}
WORKDIR /opt/yano-demo
ENV HOME=/nonexistent

# Node containers get dynamic Compose IPs, and a recreated node can take a peer's old address.
# Resolve service names on every connection so a long-running scenario never reaches the wrong
# node through a cached lookup.
ENTRYPOINT ["java", "-Dsun.net.inetaddr.ttl=0", "--add-modules=jdk.httpserver", \
    "-jar", "/opt/yano-demo/runner.jar"]
