; =============================================================================
; ADR-059 asset gateway: on-chain ABI, version 1 (anchored-claim-vault-v1)
; =============================================================================
; Everything here is Plutus Data. Constr(i, fields) is written #6.(121+i)([...])
; for i < 7. App-ledger leaves the scripts prove (ClaimLeafV1, ExitLeafV1,
; DepositRecordV1, DomainStatusV1) are NOT Plutus Data; they are the strict CBOR
; of asset-gateway-v1.cddl / asset-gateway-deposit-v1.cddl, rebuilt or read by
; the scripts byte for byte.

hash32   = bytes .size 32
hash28   = bytes .size 28
address  = plutus_address                ; the ledger's Plutus Address encoding
raw_addr = bytes .size (1 .. 128)        ; raw Shelley address bytes

; ---------------------------------------------------------------------------
; Anchor datum v2 (framework/cardano-onchain; read by MpfAnchorLib)
; ---------------------------------------------------------------------------
anchor_datum_v2 = #6.121([2, chain_id: bytes, chain_genesis_id: hash32,
  application_id: bytes, commitment_profile_id: bytes, format_fingerprint: hash32,
  height: uint, block_hash: hash32, state_root: hash32,
  member_keys: [+ hash32],               ; strictly ascending, unique
  threshold: uint,                       ; 1 .. len(member_keys)
  updated_at_ms: uint])                  ; POSIX ms

; ---------------------------------------------------------------------------
; Proofs (sdk/proof-onchain MpfOnChainVerifier)
; ---------------------------------------------------------------------------
fold = #6.121([cursor: uint, prefix: bytes, nibble: 0..15,
  neighbor1: hash32, neighbor2: hash32, neighbor3: hash32, neighbor4: hash32,
  branch_value_hash: bytes .size 0 / hash32])
inclusion_proof = #6.121([key: bytes, value: bytes, leaf_suffix: bytes, folds: [* fold]])
absence_proof   = #6.121([key: bytes, value: bytes .size 0, leaf_suffix: bytes,
  folds: [* fold], terminal_cursor: uint,
  conflicting_key_hash: bytes .size 0 / hash32, conflicting_value_hash: bytes .size 0 / hash32])
; The terminal node sits at terminal_cursor on the key's path and is one of:
;   empty slot:  leaf_suffix, conflicting_key_hash, conflicting_value_hash all empty;
;   other leaf:  conflicting_key_hash (32 bytes) names it, leaf_suffix is its encoded suffix
;                at terminal_cursor (it must differ from the key's own suffix there; the
;                key hash above that depth is unauthenticated), conflicting_value_hash its
;                value hash;
;   branch:      conflicting_key_hash empty, leaf_suffix = the branch's compressed prefix
;                (one nibble per byte, differing from the key's path in at least one nibble,
;                ending above the leaf level), conflicting_value_hash = its 16-child merkle
;                root; the node is blake2b-256(prefix || merkle).

; ---------------------------------------------------------------------------
; Vault outputs (D5; classified by constructor)
; ---------------------------------------------------------------------------
deposit_datum_v1      = #6.121([beneficiary: hash28, refund_address: bytes .size (1..64), refund_key_hash: hash28])
vault_continuation_v1 = #6.122([[0*64 hash32]])   ; ids paid (claims, or the one escape id) or [] after Accept
floor_top_up_v1       = #6.123([])
; Shapes are judged on the decoded Plutus Data (any serialization), by the script and by
; VaultOutputShape.classify alike. Accepted custody (V10, one rule for payouts, Consolidate and
; the sweep exclusion): vault_continuation_v1 holding only lovelace and the vault asset, or
; floor_top_up_v1 holding lovelace alone. A vault output may also have no datum or only a datum
; hash: unattributed custody, sweepable. migration_in_v1 is not accepted before M4b.

; The payout output (output 0) of a SweepExit: the paid claim, for the payout observer (D10). The
; observer reads it only when the shard-authenticated transaction has no vault continuation.
sweep_paid_v1 = #6.125([claim_id: hash32])

; ---------------------------------------------------------------------------
; AssetVaultValidator redeemers. One action per transaction (V13): the lead vault
; input (the first in ledger order) carries the action and runs the full check over
; every vault input; every other vault input carries the identical redeemer or the
; Follow marker. Claim fields are the ClaimLeafV1 fields for the vault's one asset:
; quantity 0 means an empty asset_value. A batch holds at most 64 claims.
; ---------------------------------------------------------------------------
claim = #6.121([claim_id: hash32, kind: 0..3, quantity: uint, vault_lovelace: uint,
  recipient: raw_addr, reserved_height: uint, reserved_at_ms: uint])
exit_claim = #6.121([claim, proof: inclusion_proof])

vault_redeemer =
    #6.121([claims: [+ claim], shard_index: 0..15])                        ; 0 Settle (NORMAL; V9)
  / #6.122([exits: [+ exit_claim], status_proof: inclusion_proof,
            shard_index: 0..15])                                           ; 1 Exit (status ignored in EXIT)
  / #6.123([claim_id: hash32, recipient: raw_addr, reserved_height: uint,
            reserved_at_ms: uint, assets: [* sweep_asset], proof: inclusion_proof,
            status_proof: inclusion_proof, sequence: uint, shard_index: 0..15])  ; 2 SweepExit (SWEEP_UNATTRIBUTED)
  / #6.124([])                                                             ; 3 AcceptCosigned (NORMAL)
  / #6.125([proofs: [+ inclusion_proof]])                                  ; 4 AcceptProved, one per vault input
  / #6.126([proof: absence_proof])                                         ; 5 RefundAbsent (EXIT)
  / #6.127([proof: inclusion_proof])                                       ; 6 RefundUncredited (EXIT)
  / #6.1280([holder_id: bytes .size (1..64), holder_key_hash: hash28,
             amount: uint, vault_lovelace: uint, recipient: raw_addr,
             proof: inclusion_proof, shard_index: 0..15])                  ; 7 BalanceExit (EXIT)
  / #6.1281([])                                                            ; 8 Consolidate (EXIT only)
  / #6.1282([])                                                            ; 9 Follow (non-lead inputs only)

sweep_asset = #6.121([policy_id: bytes, asset_name: bytes, quantity: uint])  ; canonical AssetId order

; SweepExit binds its one spent outpoint, which must not be accepted custody: the
; script computes withdrawal_key = CBOR transaction_input [tx_id, index] of that
; outpoint, asset_value from `assets` (which must be exactly the outpoint's value:
; every native asset, plus the lovelace entry for the ADA vault) and vault_lovelace
; (the outpoint's lovelace, 0 for the ADA vault) - the SweepCommitment of
; asset-gateway-contracts - then claim_id = ClaimId(domain, vault, SWEEP_UNATTRIBUTED,
; withdrawal_key, recipient, asset_value, vault_lovelace, sequence) and the leaf.
; Output 0 pays the recipient exactly the outpoint's native assets and at least its lovelace,
; with sweep_paid_v1. An outpoint whose value has more than 16 entries cannot be committed
; (asset_value's bound) and stays as stranded donor dust.
; Consolidate merges two or more accepted, clean inputs into one exact
; vault_continuation_v1([]); no shard, no payout.

; ---------------------------------------------------------------------------
; Nullifier shard (AssetShardValidator, one of 16 per vault)
; ---------------------------------------------------------------------------
shard_datum_v1 = #6.121([1, shard_index: 0..15, nullifier_root: hash32])   ; empty root = 32 zero bytes
mpf_step       = any                                   ; Aiken MPF ProofStep (Branch 0 / Fork 1 / Leaf 2)
insert         = #6.121([id: hash32, proof: [* mpf_step]])
shard_redeemer = #6.121([inserts: [+ insert]])         ; ids in payment order; value of an id = the id
; thread token: policy = ShardThreadPolicy(seed), name = h'<shard_index byte>'; the bootstrap
; mint puts each token alone in an output with shard_datum_v1(1, i, 32 zero bytes). The
; continuation keeps at least the spent lovelace and carries no reference script.

; ---------------------------------------------------------------------------
; Exit-mode thread (ExitModeThreadValidator; token: ExitModeThreadPolicy(seed), name h'',
; minted into a NORMAL datum; the EXIT continuation holds only lovelace and the token, no
; reference script)
; ---------------------------------------------------------------------------
exit_mode_v1 = #6.121([])                                                  ; NORMAL
             / #6.122([frozen_root: hash32, frozen_height: uint, frozen_at_ms: uint])  ; EXIT (terminal)
enter_exit_mode =
    #6.121([])                                                             ; (a) stale anchor
  / #6.122([request_id: hash32, absence: absence_proof])                   ; (b) censored request
  / #6.123([status: inclusion_proof])                                      ; (c) prolonged pause

; ---------------------------------------------------------------------------
; Forced-withdrawal inbox (ForcedInboxValidator: one script, mint + spend)
; ---------------------------------------------------------------------------
forced_withdrawal_v1 = #6.121([account_id: hash28, vault_id: hash32,
  amount: #6.121([1 .. 18446744073709551615]) / #6.122([]),  ; exact amount (u64) / ALL
  recipient: raw_addr, requester_key_hash: hash28,
  posted_at_ms: uint])                                  ; == validity upper bound at mint
; token name = request_id = blake2b-256("forced\0" || CBOR [tx_id, index]) of the
; minting transaction's first (smallest) spent input.
inbox_mint_redeemer  = #6.121([]) / #6.122([])          ; request / burn
inbox_spend_redeemer = #6.121([proof: inclusion_proof]) ; record forced/<id> under the anchor root
                     / #6.122([])                       ; exit mode
; Each spend burns its token and refunds the requester: the outputs whose payment key
; is requester_key_hash hold at least the summed lovelace of every inbox input of that
; requester in the transaction, which spends no script input other than this inbox's.
