{
  "schemaVersion": 1,
  "id": "org.yanoproject.x.asset-gateway.cardano",
  "version": "${pluginVersion}",
  "yanoApi": { "min": 3, "max": 3, "minLevel": 4 },
  "dependencies": [],
  "contributions": [
    {
      "kind": "l1-observer",
      "name": "asset-vault-deposit-v1",
      "provider": "org.yanoproject.x.assets.cardano.gateway.AssetVaultDepositObserverProvider"
    },
    {
      "kind": "l1-observer",
      "name": "asset-vault-payout-v1",
      "provider": "org.yanoproject.x.assets.cardano.gateway.AssetVaultPayoutObserverProvider"
    },
    {
      "kind": "l1-observer",
      "name": "asset-anchor-v1",
      "provider": "org.yanoproject.x.assets.cardano.gateway.AssetAnchorObserverProvider"
    },
    {
      "kind": "l1-observer",
      "name": "asset-shard-bootstrap-v1",
      "provider": "org.yanoproject.x.assets.cardano.gateway.AssetShardBootstrapObserverProvider"
    },
    {
      "kind": "membership-handoff-gate",
      "name": "asset-anchor-handoff-v1",
      "provider": "org.yanoproject.x.assets.cardano.gateway.AnchorHandoffGateProvider"
    }
  ]
}
