; ADR-059 M3 deposit ingress contracts, version 1. Types not defined here
; (hash32, u64, asset_id, ...) are in asset-gateway-v1.cddl.

; ---------------------------------------------------------------------------
; L1 vault datums: Plutus Data, compact constructor tags 121 + index.
; The observer classifies an output at a vault address by this tag alone (D5).
; ---------------------------------------------------------------------------

; Constructor 0. encode() emits the definite form shown; decode() also accepts
; an indefinite field list (9f .. ff) and chunked byte strings (5f .. ff) whose
; chunks are definite. Heads must be shortest form. Nothing else is accepted.
deposit_datum_v1 = #6.121([
  beneficiary_account: bytes .size 28,    ; AccountId of the consumer
  refund_address: bytes .size (1 .. 64),  ; raw Shelley address bytes
  refund_key_hash: bytes .size 28,
])

vault_continuation_v1 = #6.122([* any])   ; M4; never a deposit
floor_top_up_v1       = #6.123([])        ; exactly d87b80 or d87b9fff; operational ADA
migration_in_v1       = #6.124([* any])   ; M4b; never a deposit

vault_output_shape = 0   ; DEPOSIT
                   / 1   ; CONTINUATION
                   / 2   ; FLOOR_TOP_UP
                   / 3   ; MIGRATION_IN
                   / 4   ; OTHER: no inline datum, a datum hash, or any other datum

; ---------------------------------------------------------------------------
; Canonical Cardano value, hashed into the claim (blake2b-256). Maps are
; definite and sorted by encoded key bytes; coin-only when there are no assets.
; ---------------------------------------------------------------------------
cardano_value = u64 / [u64, { + bytes .size 28 => { + bytes .size (0 .. 32) => positive_u64 } }]

; ---------------------------------------------------------------------------
; Observer claim (strict contract subset: arrays, bytes, uints, shortest form).
; One per output at a configured vault address; eventOrdinal = output_index.
; ---------------------------------------------------------------------------
beneficiary = [0, account_id: bytes .size 28]   ; decoded deposit datum
            / [1, malformed_reason]             ; deposit tag, datum does not decode
            / [2]                               ; not deposit-shaped

malformed_reason = 1   ; DATUM_UNDECODABLE
                 / 2   ; DATUM_OUT_OF_BOUNDS (16 KiB, depth 16 by default)

asset_deposit_claim_v1 = [
  version: 1,
  deposit_id: hash32,             ; must equal deposit_id(vault_id, tx_id, output_index)
  vault_id: hash32,
  tx_id: hash32,                  ; must equal the observation's transaction anchor
  output_index: 0 .. 4294967295,  ; must equal the observation's event ordinal
  slot: uint,
  block_hash: hash32,
  shape: vault_output_shape,
  beneficiary: beneficiary,
  registered_quantity: u64,       ; the vault asset; equals lovelace for the ADA vault
  lovelace: u64,
  other_asset_count: 0 .. 4294967295,
  value_hash: hash32,             ; blake2b-256(cardano_value)
]

; ---------------------------------------------------------------------------
; Write-once deposit record at prefix || "deposit/" || deposit_id (D6 step 5).
; ---------------------------------------------------------------------------
deposit_status = 0 / 1 / 2 / 3   ; CREDITED / UNCREDITED / UNATTRIBUTED / OPERATIONAL

deposit_reason = 0    ; NONE (only with CREDITED)
               / 1    ; NOT_A_DEPOSIT
               / 2    ; FLOOR_TOP_UP
               / 3    ; DATUM_MALFORMED
               / 4    ; UNKNOWN_VAULT (wrong domain)
               / 5    ; DEPOSITS_PAUSED
               / 6    ; UNREGISTERED_ASSET
               / 7    ; MIXED_ASSETS
               / 8    ; ZERO_AMOUNT
               / 9    ; UNKNOWN_BENEFICIARY
               / 10   ; BALANCE_OVERFLOW

deposit_record_v1 = [
  version: 1,
  deposit_id: hash32,
  vault_id: hash32,
  tx_id: hash32,
  output_index: uint,
  slot: uint,
  height: uint,                   ; app ledger height that processed it
  shape: vault_output_shape,
  status: deposit_status,
  reason: deposit_reason,
  beneficiary: bytes .size 0 / bytes .size 28,
  registered_quantity: u64,
  lovelace: u64,
  other_asset_count: uint,
  value_hash: hash32,
  credited_amount: u64,           ; 0 unless CREDITED
  credited_lovelace: u64,         ; min-ADA credit; 0 unless CREDITED (and 0 for the ADA vault)
]
